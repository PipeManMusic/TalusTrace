{
  "project": "Talus Trace",
  "version": "1.0.0",
  "mandate": "Industrial-grade harness design system built on the 'Holy Millimeter' truth.",
  "specification_index": {
    "core_logic": "doc/specs/talus_trace_arch_core_spec.md",
    "ui_behavior": "doc/specs/talus_trace_arch_ui_spec.md",
    "infrastructure": "doc/specs/talus_trace_arch_infra_spec.md",
    "api_singleton": "doc/specs/talus_trace_arch_api_spec.md",
    "canvas_math": "doc/specs/talus_trace_canvas_spec.md",
    "wire_standards": "doc/specs/talus_trace_wire_labels_spec.md",
    "wire_spec": "doc/specs/talus_trace_wire_spec.md",
    "data_schema": "doc/specs/talus_trace_data_schema.md",
    "implementation": "doc/specs/talus_trace_implementation_guide.md",
    "functional_logic": "doc/specs/talus_trace_functional_logic.md"
  },
  "architectural_layers": {
    "core": {
      "path": "core/",
      "spec": "doc/specs/talus_trace_arch_core_spec.md",
      "rules": [
        "Strictly Pydantic models.",
        "Absolutely no Qt or UI imports.",
        "All spatial data stored in Millimeters (mm).",
        "Supports 'Draft-First' UNDEFINED states."
      ]
    },
    "infra": {
      "path": "infra/",
      "spec": "doc/specs/talus_trace_arch_infra_spec.md",
      "rules": [
        "Handles Command execution and Undo/Redo.",
        "Manages YAML serialization with mm precision.",
        "Enforces Optimistic Locking via entity revision IDs."
      ]
    },
    "api": {
      "path": "api/",
      "spec": "doc/specs/talus_trace_arch_api_spec.md",
      "rules": [
        "Singleton gateway; sole entry point for UI-to-Core.",
        "Converts Core mm to UI pixels for view requests.",
        "Emits 'StateChanged' signals after successful commands."
      ]
    },
    "ui": {
      "path": "ui/",
      "spec": "doc/specs/talus_trace_arch_ui_spec.md",
      "rules": [
        "PySide6/Qt-based 'Dumb Visualizer'.",
        "Translates user clicks to mm-based Commands.",
        "Grid snap: 20px (Standard).",
        "Coordinate Scale: 1.0 Zoom = 20 Pixels per Inch."
      ]
    }
  },
  "development_protocol": {
    "workflow": [
      "Check current task in fix_items.json.",
      "Write failing TDD test in tests/ before implementation.",
      "Implement minimum code to pass test.",
      "Update task status via manage_issues.py."
    ],
    "file_standard": "All coordinates are float (mm). Revisions are integer (0+).",
    "issue_tracker": "fix_items.json"
  },
  "design_system": {
    "theme": "resources/theme_tokens.json",
    "grid_major": "100px",
    "grid_minor": "20px"
  }
}